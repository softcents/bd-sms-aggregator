datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
model User { id BigInt @id @default(autoincrement()); name String; email String @unique; balance Decimal @default(0) @db.Decimal(14,4); status String @default("active"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; batches Batch[]; messages Message[]; transactions Transaction[] }
model Sender { id BigInt @id @default(autoincrement()); senderId String; type String?; status String @default("active"); userId BigInt?; user User? @relation(fields:[userId],references:[id]); messages Message[]; batches Batch[] }
model Batch { id BigInt @id @default(autoincrement()); userId BigInt; senderId BigInt?; body String; status String @default("processing"); approval String?; totalRecipients Int @default(0); validCount Int @default(0); invalidCount Int @default(0); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId],references:[id]); sender Sender? @relation(fields:[senderId],references:[id]); messages Message[]; @@index([userId,createdAt]); @@index([status]) }
model Message { id BigInt @id @default(autoincrement()); userId BigInt; batchId BigInt?; senderId BigInt?; to String; body String; status String @default("pending"); gatewayMessageId String?; cost Decimal @default(0) @db.Decimal(14,4); rate Decimal @default(0) @db.Decimal(10,4); parts Int @default(1); failedReason String?; sentAt DateTime?; deliveredAt DateTime?; nextPollAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId],references:[id]); batch Batch? @relation(fields:[batchId],references:[id]); sender Sender? @relation(fields:[senderId],references:[id]); @@index([userId,status]); @@index([userId,createdAt]); @@index([gatewayMessageId]) }
model Transaction { id BigInt @id @default(autoincrement()); userId BigInt; amount Decimal @db.Decimal(14,4); direction String; balanceBefore Decimal @db.Decimal(14,4); balanceAfter Decimal @db.Decimal(14,4); description String?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id]); @@index([userId,createdAt]) }